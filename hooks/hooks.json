{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/youmind-key-check.js\"" }],
        "description": "YouMind 命令执行前检查 YOUMIND_API_KEY，未配置则 block 并给出设置指引",
        "id": "pre:bash:youmind-key-check"
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/wechat-key-check.js\"" }],
        "description": "微信 API 命令执行前检查 WECHAT_APPID / WECHAT_APPSECRET，未配置则 block 并给出设置指引",
        "id": "pre:bash:wechat-key-check"
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/no-verify-guard.js\"" }],
        "description": "阻止 git --no-verify 标志（3 铁律强制执行：调试铁律）",
        "id": "pre:bash:no-verify"
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/tmux-hint.js\"" }],
        "description": "dev server 建议使用 tmux",
        "id": "pre:bash:tmux-hint"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/console-warn.js\"" }],
        "description": "编辑后检测 console.log 语句",
        "id": "post:edit:console-warn"
      },
      {
        "matcher": "Write",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/block-random-md.js\"" }],
        "description": "阻止随意创建 .md 文件",
        "id": "post:write:block-random-md"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/suggest-compact.js\"" }],
        "description": "每编辑 15 个文件后建议压缩上下文",
        "id": "post:edit:suggest-compact"
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-start.js\"" }],
        "description": "会话启动时加载上次上下文",
        "id": "session:start"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-end.js\"" }],
        "description": "会话结束时保存状态",
        "id": "stop:session-end"
      },
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/evaluate-session.js\"" }],
        "description": "会话结束时评估是否有值得学习的模式",
        "id": "stop:evaluate-session"
      },
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/security-scan.js\"" }],
        "description": "会话结束时扫描已修改文件的安全问题（OWASP Top 10）",
        "id": "stop:security-scan"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-compact.js\"" }],
        "description": "压缩前保存关键上下文",
        "id": "pre:compact"
      }
    ]
  }
}
